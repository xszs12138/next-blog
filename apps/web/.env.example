# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel Postgres (复制 Vercel Storage 里的 NON_POOLING URL)
DATABASE_URL=postgresql://...

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Bilibili Live (optional)
BILIBILI_ROOM_ID=

# Bangumi (optional)
BANGUMI_UID=

# 7bu 图床 (optional)
# Token 获取：注册 https://7bu.top → 购买订阅 → 用户设置 → 创建 Token（勾选上传图片权限）
# 注意：Token 只需要 | 后面的部分，例如 Token 为 1234|abcdef 则填 abcdef
7BU_TOKEN=
